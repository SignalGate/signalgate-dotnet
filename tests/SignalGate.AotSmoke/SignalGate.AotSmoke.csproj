<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SignalGate/SignalGate.csproj" />
    <!-- Root the whole library so every trim/AOT warning in it surfaces at publish time. -->
    <TrimmerRootAssembly Include="SignalGate" />
  </ItemGroup>

</Project>
